From 1e0595f95878a774e7ee19b8151b2ded08180bd7 Mon Sep 17 00:00:00 2001
From: biaogezi <scwang@bupt.edu.cn>
Date: Fri, 18 Sep 2026 11:43:32 +0800
Subject: [PATCH] perf(quant): bound prefill JIT variants and remove full-tile
 masks

---
 .../ops/quantization/int8_prefill_gemm.py     | 27 ++++++++++---------
 .../schemes/compressed_tensors_w8a8_int8.py   |  1 +
 .../srt/layers/quantization/w8a8_int8.py      |  1 +
 3 files changed, 17 insertions(+), 12 deletions(-)

diff --git a/python/sglang/kernels/ops/quantization/int8_prefill_gemm.py b/python/sglang/kernels/ops/quantization/int8_prefill_gemm.py
index 48f77f7..bc99f9f 100644
--- a/python/sglang/kernels/ops/quantization/int8_prefill_gemm.py
+++ b/python/sglang/kernels/ops/quantization/int8_prefill_gemm.py
@@ -11,7 +11,7 @@ import triton
 import triton.language as tl
 
 
-@triton.jit
+@triton.jit(do_not_specialize=["M"])
 def _int8_prefill(
     A,
     B,
@@ -19,31 +19,32 @@ def _int8_prefill(
     SB,
     BIAS,
     OUT,
-    M: tl.constexpr,
+    M,
     N: tl.constexpr,
     K: tl.constexpr,
     HAS_BIAS: tl.constexpr,
+    FULL_ROWS: tl.constexpr,
 ):
     mi = tl.program_id(0) * 128 + tl.arange(0, 128)
     ni = tl.program_id(1) * 128 + tl.arange(0, 128)
     ki = tl.arange(0, 128)
     acc = tl.full((128, 128), 0, tl.int32)
+    # Arbitrary partial-row counts share one binary, avoiding a JIT storm.
+    row_mask = tl.full((128,), True, tl.int1) if FULL_ROWS else mi < M
+    col_mask = tl.full((128,), True, tl.int1) if N % 128 == 0 else ni < N
     for step in range(tl.cdiv(K, 128)):
         kk = ki + step * 128
-        a = tl.load(
-            A + mi[:, None] * K + kk[None, :], (mi[:, None] < M) & (kk[None, :] < K), other=0
-        )
-        b = tl.load(
-            B + kk[:, None] + ni[None, :] * K, (kk[:, None] < K) & (ni[None, :] < N), other=0
-        )
+        k_mask = tl.full((128,), True, tl.int1) if K % 128 == 0 else kk < K
+        a = tl.load(A + mi[:, None] * K + kk[None, :], row_mask[:, None] & k_mask[None, :], other=0)
+        b = tl.load(B + kk[:, None] + ni[None, :] * K, k_mask[:, None] & col_mask[None, :], other=0)
         acc += tl.dot(a, b)
-    sa = tl.load(SA + mi, mi < M, other=0)
-    sb = tl.load(SB + ni, ni < N, other=0)
+    sa = tl.load(SA + mi, row_mask, other=0)
+    sb = tl.load(SB + ni, col_mask, other=0)
     # Match CUTLASS's multiplication order; no reassociation or fused bias FMA.
     values = acc.to(tl.float32) * (sa[:, None] * sb[None, :])
     if HAS_BIAS:
-        values += tl.load(BIAS + ni, ni < N, other=0).to(tl.float32)[None, :]
-    tl.store(OUT + mi[:, None] * N + ni[None, :], values, (mi[:, None] < M) & (ni[None, :] < N))
+        values += tl.load(BIAS + ni, col_mask, other=0).to(tl.float32)[None, :]
+    tl.store(OUT + mi[:, None] * N + ni[None, :], values, row_mask[:, None] & col_mask[None, :])
 
 
 def supports_a10_prefill(a, b, sa, sb, out_dtype, bias=None):
@@ -68,6 +69,7 @@ def supports_a10_prefill(a, b, sa, sb, out_dtype, bias=None):
             bias is None
             or (
                 bias.device == a.device
+                and bias.ndim == 1
                 and bias.dtype == out_dtype
                 and bias.is_contiguous()
                 and bias.numel() == b.shape[1]
@@ -91,6 +93,7 @@ def a10_int8_prefill_mm(a, b, sa, sb, out_dtype, bias=None):
         n,
         k,
         bias is not None,
+        m == 128,
         num_warps=4,
         num_stages=3,
         enable_fp_fusion=False,
diff --git a/python/sglang/srt/layers/quantization/compressed_tensors/schemes/compressed_tensors_w8a8_int8.py b/python/sglang/srt/layers/quantization/compressed_tensors/schemes/compressed_tensors_w8a8_int8.py
index 74e0daa..4c105ed 100644
--- a/python/sglang/srt/layers/quantization/compressed_tensors/schemes/compressed_tensors_w8a8_int8.py
+++ b/python/sglang/srt/layers/quantization/compressed_tensors/schemes/compressed_tensors_w8a8_int8.py
@@ -105,6 +105,7 @@ class CompressedTensorsW8A8Int8(CompressedTensorsLinearScheme):
         self._a10_prefill = (
             _is_cuda
             and os.getenv("SGLANG_A10_INT8_PREFILL", "false").lower() in ("true", "1")
+            and layer.weight.is_cuda
             and not self.is_static_input_scheme
             and self.input_symmetric
             and torch.cuda.get_device_capability(layer.weight.device) == (8, 6)
diff --git a/python/sglang/srt/layers/quantization/w8a8_int8.py b/python/sglang/srt/layers/quantization/w8a8_int8.py
index 8a3776e..a5eb492 100644
--- a/python/sglang/srt/layers/quantization/w8a8_int8.py
+++ b/python/sglang/srt/layers/quantization/w8a8_int8.py
@@ -175,6 +175,7 @@ class W8A8Int8LinearMethod(LinearMethodBase):
         self._a10_prefill = (
             _is_cuda
             and os.getenv("SGLANG_A10_INT8_PREFILL", "false").lower() in ("true", "1")
+            and layer.weight.is_cuda
             and torch.cuda.get_device_capability(layer.weight.device) == (8, 6)
         )
 
-- 
