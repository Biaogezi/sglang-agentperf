diff --git a/python/sglang/srt/managers/slo_aware_chunking.py b/python/sglang/srt/managers/slo_aware_chunking.py
new file mode 100644
index 0000000..bc6200c
--- /dev/null
+++ b/python/sglang/srt/managers/slo_aware_chunking.py
@@ -0,0 +1,13 @@
+from typing import Optional
+
+
+def select_slo_aware_chunk_size(
+    base_chunk_size: Optional[int],
+    active_decode_chunk_size: int,
+    running_decode_requests: int,
+    enabled: bool,
+) -> Optional[int]:
+    """Select a latency-oriented prefill chunk only during mixed prefill/decode."""
+    if not enabled or running_decode_requests <= 0 or base_chunk_size is None:
+        return base_chunk_size
+    return min(base_chunk_size, active_decode_chunk_size)
diff --git a/python/sglang/srt/server_args.py b/python/sglang/srt/server_args.py
index fa4b80e..b2f2138 100644
--- a/python/sglang/srt/server_args.py
+++ b/python/sglang/srt/server_args.py
@@ -725,6 +725,16 @@ class ServerArgs:
         "Enable dynamic chunk size adjustment for pipeline parallelism. When enabled, chunk sizes are dynamically calculated based on fitted function to maintain consistent execution time across chunks.",
         NS("schedule"),
     ] = False
+    enable_slo_aware_chunking: A[
+        bool,
+        "Use a smaller prefill chunk while decode requests are active to reduce inter-token latency.",
+        NS("schedule"),
+    ] = False
+    slo_aware_chunked_prefill_size: A[
+        int,
+        "The prefill chunk size used while decode requests are active and SLO-aware chunking is enabled.",
+        NS("schedule"),
+    ] = 512
     max_prefill_tokens: A[
         int,
         Arg(
diff --git a/test/registered/unit/managers/test_slo_aware_chunking.py b/test/registered/unit/managers/test_slo_aware_chunking.py
new file mode 100644
index 0000000..54f99d4
--- /dev/null
+++ b/test/registered/unit/managers/test_slo_aware_chunking.py
@@ -0,0 +1,13 @@
+from sglang.srt.managers.slo_aware_chunking import select_slo_aware_chunk_size
+
+
+def test_uses_base_chunk_without_active_decode() -> None:
+    assert select_slo_aware_chunk_size(2048, 512, 0, True) == 2048
+
+
+def test_caps_chunk_with_active_decode() -> None:
+    assert select_slo_aware_chunk_size(2048, 512, 4, True) == 512
+
+
+def test_disabled_mode_preserves_base_chunk() -> None:
+    assert select_slo_aware_chunk_size(2048, 512, 4, False) == 2048
