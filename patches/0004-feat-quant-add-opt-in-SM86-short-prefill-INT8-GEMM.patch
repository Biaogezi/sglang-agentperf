diff --git a/python/sglang/kernels/ops/quantization/int8_prefill_gemm.py b/python/sglang/kernels/ops/quantization/int8_prefill_gemm.py
new file mode 100644
index 0000000..48f77f7
--- /dev/null
+++ b/python/sglang/kernels/ops/quantization/int8_prefill_gemm.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in SM86 W8A8 short-prefill GEMM.
+
+This kernel uses an INT32 Tensor Core accumulator and combines row/channel
+scaling in the epilogue. Its 128x128x128 tile is selected only for measured
+medium-M Qwen3-8B projections; all other shapes retain the existing backend.
+"""
+
+import torch
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _int8_prefill(
+    A,
+    B,
+    SA,
+    SB,
+    BIAS,
+    OUT,
+    M: tl.constexpr,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    HAS_BIAS: tl.constexpr,
+):
+    mi = tl.program_id(0) * 128 + tl.arange(0, 128)
+    ni = tl.program_id(1) * 128 + tl.arange(0, 128)
+    ki = tl.arange(0, 128)
+    acc = tl.full((128, 128), 0, tl.int32)
+    for step in range(tl.cdiv(K, 128)):
+        kk = ki + step * 128
+        a = tl.load(
+            A + mi[:, None] * K + kk[None, :], (mi[:, None] < M) & (kk[None, :] < K), other=0
+        )
+        b = tl.load(
+            B + kk[:, None] + ni[None, :] * K, (kk[:, None] < K) & (ni[None, :] < N), other=0
+        )
+        acc += tl.dot(a, b)
+    sa = tl.load(SA + mi, mi < M, other=0)
+    sb = tl.load(SB + ni, ni < N, other=0)
+    # Match CUTLASS's multiplication order; no reassociation or fused bias FMA.
+    values = acc.to(tl.float32) * (sa[:, None] * sb[None, :])
+    if HAS_BIAS:
+        values += tl.load(BIAS + ni, ni < N, other=0).to(tl.float32)[None, :]
+    tl.store(OUT + mi[:, None] * N + ni[None, :], values, (mi[:, None] < M) & (ni[None, :] < N))
+
+
+def supports_a10_prefill(a, b, sa, sb, out_dtype, bias=None):
+    """Shape/layout contract; hardware and environment are checked at weight load."""
+    return (
+        a.ndim == 2
+        and b.ndim == 2
+        and a.device == b.device == sa.device == sb.device
+        and a.dtype == b.dtype == torch.int8
+        and out_dtype in (torch.float16, torch.bfloat16)
+        and a.is_contiguous()
+        and b.stride() == (1, a.shape[1])
+        and 80 <= a.shape[0] <= 128
+        and a.shape[1] == b.shape[0] == 4096
+        and b.shape[1] in (6144, 24576)
+        and sa.dtype == sb.dtype == torch.float32
+        and sa.is_contiguous()
+        and sb.is_contiguous()
+        and sa.numel() == a.shape[0]
+        and sb.numel() == b.shape[1]
+        and (
+            bias is None
+            or (
+                bias.device == a.device
+                and bias.dtype == out_dtype
+                and bias.is_contiguous()
+                and bias.numel() == b.shape[1]
+            )
+        )
+    )
+
+
+def a10_int8_prefill_mm(a, b, sa, sb, out_dtype, bias=None):
+    m, k = a.shape
+    n = b.shape[1]
+    out = torch.empty((m, n), device=a.device, dtype=out_dtype)
+    _int8_prefill[(triton.cdiv(m, 128), triton.cdiv(n, 128))](
+        a,
+        b,
+        sa,
+        sb,
+        bias,
+        out,
+        m,
+        n,
+        k,
+        bias is not None,
+        num_warps=4,
+        num_stages=3,
+        enable_fp_fusion=False,
+    )
+    return out
