+import os
 from typing import Callable, Optional
 
 import torch
@@ -38,6 +39,7 @@ class CompressedTensorsW8A8Int8(CompressedTensorsLinearScheme):
         self.strategy = strategy
         self.is_static_input_scheme = is_static_input_scheme
         self.input_symmetric = input_symmetric
+        self._a10_prefill = False
 
     def create_weights(
         self,
@@ -100,6 +102,13 @@ class CompressedTensorsW8A8Int8(CompressedTensorsLinearScheme):
         return 80
 
     def process_weights_after_loading(self, layer) -> None:
+        self._a10_prefill = (
+            _is_cuda
+            and os.getenv("SGLANG_A10_INT8_PREFILL", "false").lower() in ("true", "1")
+            and not self.is_static_input_scheme
+            and self.input_symmetric
+            and torch.cuda.get_device_capability(layer.weight.device) == (8, 6)
+        )
         # If per tensor, when we have a fused module (e.g. QKV) with per
         # tensor scales (thus N scales being passed to the kernel),
         # requantize so we can always run per channel
@@ -179,6 +188,19 @@ class CompressedTensorsW8A8Int8(CompressedTensorsLinearScheme):
             output_dtype = x.dtype
             x_q, x_scale = per_token_quant_int8(x)
 
+        if self._a10_prefill:
+            from sglang.kernels.ops.quantization.int8_prefill_gemm import (
+                a10_int8_prefill_mm,
+                supports_a10_prefill,
+            )
+
+            if supports_a10_prefill(
+                x_q, layer.weight, x_scale, layer.weight_scale, output_dtype, bias
+            ):
+                return a10_int8_prefill_mm(
+                    x_q, layer.weight, x_scale, layer.weight_scale, output_dtype, bias
+                )
+
         return int8_scaled_mm(
             x_q,
             layer.weight,
