+class TestFusedRMSNormInt8Quant(CustomTestCase):
+    @classmethod
+    def setUpClass(cls):
+        if not torch.cuda.is_available():
+            raise unittest.SkipTest("CUDA is not available")
+
+    def _check(self, dtype: torch.dtype, use_residual: bool):
+        torch.manual_seed(7)
+        x = torch.randn((17, 4096), device="cuda", dtype=dtype)
+        weight = torch.randn((4096,), device="cuda", dtype=dtype)
+        residual = (
+            torch.randn_like(x, device="cuda") if use_residual else None
+        )
+        x_ref = x.clone()
+        residual_ref = residual.clone() if residual is not None else None
+        if residual_ref is None:
+            normed = rmsnorm(x_ref, weight, 1e-6)
+        else:
+            fused_add_rmsnorm(x_ref, residual_ref, weight, 1e-6)
+            normed = x_ref
+        expected_q, expected_scale = per_token_quant_int8(normed)
+
+        actual_q, actual_scale = rmsnorm_quant_int8(
+            x, weight, 1e-6, residual=residual
+        )
+
+        self.assertTrue(torch.equal(actual_q, expected_q))
+        torch.testing.assert_close(actual_scale, expected_scale, rtol=1e-5, atol=1e-6)
+        if residual is not None:
+            torch.testing.assert_close(residual, residual_ref, rtol=0, atol=0)
+
+    def test_matches_unfused_fp16(self):
+        self._check(torch.float16, use_residual=False)
+        self._check(torch.float16, use_residual=True)
+
+    def test_matches_unfused_bf16(self):
+        self._check(torch.bfloat16, use_residual=False)
+        self._check(torch.bfloat16, use_residual=True)
+
+
 class TestW8A8Int8FusedMoE(CustomTestCase):
     DTYPES = [torch.half, torch.bfloat16]
