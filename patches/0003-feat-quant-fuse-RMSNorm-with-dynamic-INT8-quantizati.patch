+def _is_dynamic_per_token_int8_linear(linear) -> bool:
+    """Return whether ``linear`` accepts pre-quantized dynamic W8A8 input."""
+    if linear is None:
+        return False
+    try:
+        from sglang.srt.layers.quantization.compressed_tensors.compressed_tensors import (
+            CompressedTensorsLinearMethod,
+        )
+        from sglang.srt.layers.quantization.compressed_tensors.schemes import (
+            CompressedTensorsW8A8Int8,
+        )
+    except ImportError:
+        return False
+
+    quant_method = getattr(linear, "quant_method", None)
+    scheme = getattr(linear, "scheme", None)
+    return (
+        isinstance(quant_method, CompressedTensorsLinearMethod)
+        and isinstance(scheme, CompressedTensorsW8A8Int8)
+        and not scheme.is_static_input_scheme
+        and scheme.input_symmetric
+    )
+
+
 class RMSNorm(BaseFusedOp):
     def __init__(
         self,
@@ -521,6 +548,15 @@ class RMSNorm(BaseFusedOp):
             if needs_reshape:
                 out = out.reshape(original_shape)
             return out
+        if (
+            _enable_w8a8_fused_rmsnorm_quant
+            and quant_linear is not None
+            and not self.cast_x_before_out_mul
+            and _is_dynamic_per_token_int8_linear(quant_linear)
+        ):
+            return self.forward_with_dynamic_int8_quant_fusion(
+                x, residual, post_residual_addition
+            )
         # Fuse the downstream FP8 static per-tensor activation quant into the
         # norm when supported. Placed after the empty / variance-override /
         # batch-invariant guards above (all incompatible with the fused kernel)
@@ -608,6 +644,29 @@ class RMSNorm(BaseFusedOp):
             return result.reshape(original_shape)
         return result
 
+    def forward_with_dynamic_int8_quant_fusion(
+        self,
+        x: torch.Tensor,
+        residual: Optional[torch.Tensor] = None,
+        post_residual_addition: Optional[torch.Tensor] = None,
+    ):
+        """Fuse RMSNorm with dynamic per-token INT8 activation quantization."""
+        from sglang.kernels.ops.quantization.int8_kernel import rmsnorm_quant_int8
+
+        if post_residual_addition is not None:
+            assert residual is not None
+            residual = residual + post_residual_addition
+        x_q, x_scale = rmsnorm_quant_int8(
+            x,
+            self.weight.data,
+            self.variance_epsilon,
+            residual=residual,
+        )
+        prequantized = (x_q, x_scale, x.dtype)
+        if residual is not None:
+            return prequantized, residual
+        return prequantized
+
     def forward_npu(
         self,
