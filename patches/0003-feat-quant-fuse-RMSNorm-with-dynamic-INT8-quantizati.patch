diff --git a/python/sglang/kernels/ops/quantization/int8_kernel.py b/python/sglang/kernels/ops/quantization/int8_kernel.py
index 3c73744..1fc3b4b 100644
--- a/python/sglang/kernels/ops/quantization/int8_kernel.py
+++ b/python/sglang/kernels/ops/quantization/int8_kernel.py
@@ -90,6 +90,94 @@ def per_token_quant_int8(x, scale_dtype=torch.float32, cal_sum=False):
         return x_q, scales
 
 
+@triton.jit
+def _rmsnorm_quant_int8(
+    x_ptr,
+    residual_ptr,
+    weight_ptr,
+    xq_ptr,
+    scale_ptr,
+    stride_x,
+    stride_xq,
+    N,
+    eps,
+    HAS_RESIDUAL: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    """Fused residual add, RMSNorm, and dynamic per-token INT8 quantization."""
+    row_id = tl.program_id(0)
+    cols = tl.arange(0, BLOCK)
+    mask = cols < N
+
+    x_offsets = row_id * stride_x + cols
+    x = tl.load(x_ptr + x_offsets, mask=mask, other=0.0).to(tl.float32)
+    if HAS_RESIDUAL:
+        residual = tl.load(residual_ptr + x_offsets, mask=mask, other=0.0).to(
+            tl.float32
+        )
+        x += residual
+        # Match fused_add_rmsnorm: publish the pre-normalization residual in-place.
+        tl.store(residual_ptr + x_offsets, x, mask=mask)
+
+    variance = tl.sum(x * x, axis=0) / N
+    normed = x * tl.rsqrt(variance + eps)
+    weight = tl.load(weight_ptr + cols, mask=mask, other=0.0).to(tl.float32)
+    normed *= weight
+
+    # Match the unfused path's model-dtype RMSNorm output before quantization.
+    normed = normed.to(x_ptr.dtype.element_ty).to(tl.float32)
+    absmax = tl.maximum(tl.max(tl.abs(normed)), 1e-10)
+    scale = absmax / 127.0
+    quantized = tl.extra.cuda.libdevice.round(normed * (127.0 / absmax)).to(tl.int8)
+
+    tl.store(xq_ptr + row_id * stride_xq + cols, quantized, mask=mask)
+    tl.store(scale_ptr + row_id, scale)
+
+
+def rmsnorm_quant_int8(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    residual: Optional[torch.Tensor] = None,
+):
+    """Fuse RMSNorm and dynamic per-token INT8 quantization on CUDA.
+
+    When ``residual`` is provided it is updated in-place with ``x + residual``,
+    matching the residual contract of SGLang's ``fused_add_rmsnorm`` operator.
+    """
+    assert x.is_cuda and x.is_contiguous()
+    assert x.dtype in (torch.float16, torch.bfloat16)
+    assert x.shape[-1] == weight.numel()
+    if residual is not None:
+        assert residual.is_contiguous() and residual.shape == x.shape
+        assert residual.dtype == x.dtype
+
+    original_shape = x.shape
+    x_2d = x.view(-1, x.shape[-1])
+    residual_2d = residual.view_as(x_2d) if residual is not None else None
+    x_q = torch.empty_like(x_2d, dtype=torch.int8)
+    scales = torch.empty((x_2d.shape[0], 1), device=x.device, dtype=torch.float32)
+    block = triton.next_power_of_2(x_2d.shape[-1])
+    num_warps = min(max(block // 256, 1), 8)
+
+    _rmsnorm_quant_int8[(x_2d.shape[0],)](
+        x_2d,
+        residual_2d,
+        weight,
+        x_q,
+        scales,
+        stride_x=x_2d.stride(0),
+        stride_xq=x_q.stride(0),
+        N=x_2d.shape[-1],
+        eps=eps,
+        HAS_RESIDUAL=residual is not None,
+        BLOCK=block,
+        num_warps=num_warps,
+        num_stages=1,
+    )
+    return x_q.view(original_shape), scales.view(*original_shape[:-1], 1)
+
+
